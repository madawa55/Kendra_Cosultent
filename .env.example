DATABASE_URL=postgres://user:password@localhost:5432/kendra
PORT=5000
LOG_LEVEL=info

# SMTP credentials for sending inquiry emails.
# The hosting SMTP (mail.consultkendra.com) is blocked for external connections,
# so send through Gmail instead. Requires a Gmail App Password (enable 2-Step
# Verification at https://myaccount.google.com/security, then create an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Who inquiries are sent to and from.
# MAIL_FROM defaults to SMTP_USER (your Gmail). Emails land in MAIL_TO's inbox.
# To show info@consultkendra.com as the sender, add it in Gmail under
# Settings > Accounts > "Send mail as" (verify it, then set MAIL_FROM below).
# MAIL_FROM=info@consultkendra.com
MAIL_TO=info@consultkendra.com
